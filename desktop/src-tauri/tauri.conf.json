{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wyze Tunnel",
  "version": "0.1.3",
  "identifier": "com.itskiwi.wyzetunnel",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../mac/install.sh": "mac/install.sh",
      "../../windows/install.ps1": "windows/install.ps1",
      "../../windows/install-native.ps1": "windows/install-native.ps1"
    },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "13.0" }
  }
}
