# Wyze Tunnel settings. Restart after editing: sudo systemctl restart wyze-tunnel
# Every option from the README works here as NAME=value.

# Leave these blank to sign in from the web page instead (recommended).
# API Key and ID: https://developer-api-console.wyze.com/#/apikey/view
WYZE_EMAIL=
WYZE_PASSWORD=
API_ID=
API_KEY=

# IP address of this machine, needed for WebRTC. Filled in by the installer.
WB_IP=

# Web UI and stream authentication
WB_AUTH=True
#WB_USERNAME=
#WB_PASSWORD=
